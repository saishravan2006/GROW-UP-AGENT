# ── Super Memory · Environment Config ──
# Copy to .env and fill in your API key

# LLM Provider (OpenRouter with DeepSeek R1)
OPENAI_API_KEY=your-openrouter-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-r1:free

# Backup: qwen/qwen-2.5-coder-32b-instruct (or similar Coder model)
# OPENAI_MODEL=qwen/qwen-2.5-coder-32b-instruct
